# ============================================================
#  ZZZ Lend - Contracts 环境变量示例
#  用法: 复制本文件为 .env 并填入真实值
#  复制命令 (PowerShell):  Copy-Item .env.example .env
#  ⚠️ 严禁把真实私钥/RPC 写入代码，严禁提交 .env 到版本库！
# ============================================================

# --- Sepolia 测试网 RPC (用你自己的 RPC 服务商，如 Alchemy / Infura) ---
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# Infura: https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# --- 主网 RPC (仅用于 forge test --fork 只读分叉测试，绝不触碰资金) ---
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# --- 测试网私钥 (仅限测试网！用 cast wallet new 生成全新钱包) ---
# 生成命令: cast wallet new
# 切勿使用任何与真实资产相关的主网私钥
PRIVATE_KEY=0xREPLACE_WITH_TESTNET_PRIVATE_KEY

# --- 合约验证 (Etherscan/Sourcify) ---
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# --- 区块浏览器 ---
# ETHERSCAN_URL=https://sepolia.etherscan.io

# --- Sepolia 部署配置 (阶段 7) ---
# Chainlink 聚合器地址 (部署前在对应链官方文档二次确认)
SEPOLIA_ETH_USD_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306
SEPOLIA_USDC_USD_FEED=0xA2F78ab2355fe2f984D808B5CeE7FD0A93D5270E

# 测试网管理地址 (PARAM_ADMIN/PAUSER/Owner 移交对象；留空则默认部署者)
# TESTNET_ADMIN=0xYOUR_TESTNET_ADMIN_ADDRESS

# --- 端到端测试用户 (仅公钥，用于 E2E 演示角色) ---
# E2E_USER_A=0x...
# E2E_USER_B=0x...
