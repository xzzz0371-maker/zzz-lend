# ============================================================
#  ZZZ Lend - Contracts 环境变量示例
#  用法: 复制本文件为 .env 并填入真实值
#  复制命令 (PowerShell):  Copy-Item .env.example .env
#  ⚠️ 严禁把真实私钥/RPC 写入代码，严禁提交 .env 到版本库！
# ============================================================

# --- Sepolia 测试网 RPC (用你自己的 RPC 服务商，如 Alchemy / Infura) ---
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# Infura: https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# --- 主网 RPC (仅用于 forge test --fork 只读分叉测试，绝不触碰资金) ---
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# --- 测试网私钥 (仅限测试网！用 cast wallet new 生成全新钱包) ---
# 生成命令: cast wallet new
# 切勿使用任何与真实资产相关的主网私钥
PRIVATE_KEY=0xREPLACE_WITH_TESTNET_PRIVATE_KEY

# --- 合约验证 (Etherscan/Sourcify) ---
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# --- 区块浏览器 ---
# ETHERSCAN_URL=https://sepolia.etherscan.io

# --- Sepolia 部署配置 (阶段 7) ---
# Chainlink 聚合器地址 (部署前在对应链官方文档二次确认)
SEPOLIA_ETH_USD_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306
SEPOLIA_USDC_USD_FEED=0xA2F78ab2355fe2f984D808B5CeE7FD0A93D5270E

# 测试网管理地址 (PARAM_ADMIN/PAUSER/Owner 移交对象；留空则默认部署者)
# TESTNET_ADMIN=0xYOUR_TESTNET_ADMIN_ADDRESS

# ============================================================
#  主网就绪部署模板 (script/DeployMainnet.s.sol) — Base 主网 (chainId 8453)
#  说明：token/feed 地址默认已内建于脚本（= Base 官方 Chainlink feed / 官方代币，已链上核验）。
#       下方仅当你需要覆盖默认值或明确填写时才需取消注释。测试网演示请用 Deploy.s.sol。
# ============================================================
# MAINNET_ADMIN=0xYOUR_MAINNET_MULTISIG          # 必填：最终 Owner/角色持有者（多签）
# MAINNET_TREASURY=0xYOUR_MAINNET_TREASURY       # 必填：Treasury 收款地址
# MAINNET_PAUSER=0xYOUR_MAINNET_PAUSER           # 可选：独立 Pauser；默认=admin
# --- Base 官方 Chainlink feed / 代币（脚本已内置默认，以下为参考值） ---
# MAINNET_ETH_USD_FEED=0x50015f8b17fb2C290Dde41fDc246ed0dcEE93a8b
# MAINNET_USDC_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# MAINNET_USDC_USD_FEED=0x7e860098F58bBFC8648a4311b374B1D669a2bc6B
# --- token 白名单（默认值见脚本；ENABLE_*=false 则不注册该资产） ---
# ENABLE_USDT=false
# MAINNET_USDT_TOKEN=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2
# MAINNET_USDT_USD_FEED=0xf19d560eB8d2ADf07BD6D13ed03e1D11215721F9
# ENABLE_DAI=false
# MAINNET_DAI_TOKEN=0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb
# MAINNET_DAI_USD_FEED=0x591e79239a7d679378eC8c847e5038150364C78F
# ENABLE_CBBTC=false
# MAINNET_CBBTC_TOKEN=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf
# MAINNET_CBBTC_USD_FEED=0x07DA0E54543a844a80ABE69c8A12F22B3aA59f9D
# --- wstETH：合约保留支持但 Base V1 禁用（无官方 wstETH/ETH 或 wstETH/USD feed） ---
#         Base 官方仅有 wstETH/stETH (0xB88BAc61a4Ca37C43a3725912B1f472c9A5bc061)；合成缺 stETH/ETH 官方源，
#         故主网不放行。待官方 feed 就绪后设 ENABLE_WSTETH=true 并填以下两项：
# ENABLE_WSTETH=false
# MAINNET_WSTETH_TOKEN=0x...
# MAINNET_WSTETH_USD_FEED=0x...
# --- 供应/抵押上限风控（0 或留空 = 不限制；单位为该资产 token 原始单位） ---
# MAINNET_USDC_SUPPLY_CAP=0
# MAINNET_USDT_SUPPLY_CAP=0
# MAINNET_DAI_SUPPLY_CAP=0
# MAINNET_ETH_COLLATERAL_CAP=0
# MAINNET_WSTETH_COLLATERAL_CAP=0
# MAINNET_CBBTC_COLLATERAL_CAP=0
# --- 治理 Timelock（可选；>0 时部署 OZ TimelockController，admin 为 proposer/executor） ---
# MAINNET_TIMELOCK_MIN_DELAY=0

# --- 端到端测试用户 (仅公钥，用于 E2E 演示角色) ---
# E2E_USER_A=0x...
# E2E_USER_B=0x...
